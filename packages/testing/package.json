{
  "name": "@nestjs-cognito/testing",
  "version": "2.3.0",
  "description": "Cognito testing helpers for NestJS-Cognito",
  "author": "Loik Fekkai",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nestjs",
    "nestjs-cognito",
    "nest",
    "aws",
    "aws-cognito",
    "cognito",
    "testing",
    "test",
    "unit-test",
    "e2e",
    "mock",
    "jwt",
    "test-helpers",
    "testing-utilities",
    "typescript"
  ],
  "homepage": "https://lokicoule.github.io/nestjs-cognito/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lokicoule/nestjs-cognito.git"
  },
  "scripts": {
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../../node_modules/jest/bin/jest.js --config ./tests/jest-e2e.json --detectOpenHandles",
    "test:e2e:dev": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../../node_modules/jest/bin/jest.js --config ./tests/jest-e2e.json --watch --detectOpenHandles"
  },
  "bugs": {
    "url": "https://github.com/Lokicoule/nestjs-cognito/issues"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1140.0",
    "@nestjs-cognito/core": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/testing": "12.1.0"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.744.0",
    "@nestjs-cognito/core": "workspace:^",
    "@nestjs/common": "^11.0.0 || ^12.0.0"
  }
}
