{
  "name": "@nestjs-cognito/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Nest - Cognito Monorepo",
  "author": "Loik Fekkai",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b -v packages",
    "check:types": "tsc -p packages/consumer-check",
    "clean": "tsc -b --clean packages",
    "clean:deps": "pnpm -r exec rm -rf node_modules && pnpm install",
    "coverage": "pnpm test --coverage",
    "format": "prettier packages/**/*.ts --ignore-path ./.prettierignore --write",
    "lint": "eslint 'packages/**/*.ts'",
    "lint:fix": "eslint 'packages/**/*.ts' --fix",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:e2e": "pnpm -r run test:e2e",
    "test:e2e:auth": "pnpm --filter @nestjs-cognito/auth run test:e2e",
    "test:e2e:core": "pnpm --filter @nestjs-cognito/core run test:e2e",
    "test:e2e:graphql": "pnpm --filter @nestjs-cognito/graphql run test:e2e",
    "cw": "commitizard -s conventional",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@apollo/server": "5.5.1",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-angular": "21.2.4",
    "@golevelup/ts-jest": "3.0.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/microservices": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/testing": "12.1.3",
    "@nestjs/websockets": "12.1.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "graphql": "16.14.2",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "pactum": "3.9.1",
    "prettier": "3.9.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "packages/*/lib/**/*.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/packages/tsconfig.spec.json"
        }
      ]
    },
    "preset": "ts-jest"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lokicoule/nestjs-cognito.git"
  },
  "packageManager": "pnpm@10.34.8+sha512.f627a8e971343afe49dfd0f63d028234201dfa831d5cb588733e1e5f8db26bf16989a32161ab5c1b4db3b1fdbc373160606b5b89e002df6dd19a85adf91fc5a8"
}
